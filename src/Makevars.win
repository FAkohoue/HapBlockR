## src/Makevars.in
##
## Generated by configure into src/Makevars
##
## Rtools configures SHLIB_OPENMP_CXXFLAGS for the active compiler toolchain.
## When OpenMP is unavailable the variable is empty and the guarded C++ code
## builds in serial mode.

PKG_CXXFLAGS = $(SHLIB_OPENMP_CXXFLAGS) -DARMA_NO_DEBUG
PKG_LIBS     = $(SHLIB_OPENMP_CXXFLAGS) $(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS)
