Package: DesiredGainR
Type: Package
Title: Desired-Gain Selection Index and Quadratic Genomic Selection
        Index Tools for Plant Breeding
Version: 0.5.0
Authors@R: 
    person(
      given   = "Félicien",
      family  = "Akohoue",
