Package: HapBlockR
Type: Package
Title: Genome-Wide LD Block Detection, Haplotype Analysis, Genomic Prediction, and Breeding Decision Support
Version: 0.3.12.9000
Date: 2026-07-18
Authors@R:
    person(
      given   = "Félicien",
      family  = "Akohoue",
